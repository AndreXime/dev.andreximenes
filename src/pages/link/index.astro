---
import ListingLayout from "@/components/layout/ListingLayout.astro";
import SEOLayout from "@/components/layout/SEOLayout.astro";
import { pageTitle } from "@/content/site";
import { loadPosts } from "@/lib/listing";

const recentPosts = await loadPosts("link");
---

<SEOLayout title={pageTitle("Links")}>
	<ListingLayout recentPosts={recentPosts} activeCategory="link" />
</SEOLayout>

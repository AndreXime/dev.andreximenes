---
import SEOLayout from "@/components/layout/SEOLayout.astro";
import MainLayout from "@/components/layout/MainLayout.astro";
import { AUTHOR } from "@/content/author";
import { pageTitle as buildPageTitle, SITE_NAME } from "@/content/site";
import { ExternalLinkIcon } from "lucide-react";
---

<SEOLayout
	title={buildPageTitle("Sobre mim")}
	description={`Quem escreve o ${SITE_NAME}: André Ximenes, desenvolvedor backend TypeScript. Portfólio, LinkedIn e GitHub.`}
>
	<MainLayout activeCategory="author">
		<article class="container-page py-lg pb-3xl">
			<header class="max-w-measure border-b border-rule pb-md">
				<p class="mb-2xs text-sm text-muted">
					{AUTHOR.role}
				</p>
				<h1
					class="m-0 font-display text-xl leading-snug font-semibold tracking-display text-ink"
				>
					{AUTHOR.name}
				</h1>
				<p class="mt-sm text-md leading-(--lh-prose) text-muted">
					{AUTHOR.lede}
				</p>
			</header>

			<div class="flex max-w-measure flex-col gap-lg pt-lg">
				{
					AUTHOR.body.map((paragraph) => (
						<p class="m-0 text-md leading-(--lh-prose) text-ink-2">
							{paragraph}
						</p>
					))
				}

				<section
					class="flex flex-col gap-sm border-t border-rule pt-md"
					aria-labelledby="author-links"
				>
					<h2
						id="author-links"
						class="m-0 text-sm font-medium text-muted"
					>
						Onde me encontrar
					</h2>
					<ul class="m-0 list-none divide-y divide-rule p-0">
						{
							AUTHOR.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="focus-ring group flex min-h-11 flex-col gap-3xs py-sm no-underline"
										target="_blank"
										rel="noopener noreferrer"
									>
										<span class="flex items-center gap-2xs font-medium text-ink group-hover:text-accent">
											{link.label}
											<ExternalLinkIcon className="size-3.5 shrink-0 text-muted" />
										</span>
										<span class="text-sm leading-normal text-muted">
											{link.description}
										</span>
										<span class="text-sm text-muted">
											{link.host}
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>
		</article>
	</MainLayout>
</SEOLayout>

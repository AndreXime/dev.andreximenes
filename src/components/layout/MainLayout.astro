---
import Nav from "../ui/Nav.astro";

interface Props {
	activeCategory: string;
	brandMark?: boolean;
}

const { activeCategory, brandMark = false } = Astro.props;
---

<div class="flex min-h-dvh flex-col">
	<Nav activeCategory={activeCategory} brandMark={brandMark} />
	<main class="flex-1">
		<slot />
	</main>
</div>

---
import "../../styles/global.css";
import { SITE_DESCRIPTION, SITE_NAME } from "@/content/site";

interface Props {
	title: string;
	description?: string;
	ogType?: "website" | "article";
}

const { title, description = SITE_DESCRIPTION, ogType = "website" } = Astro.props;
const site = Astro.site ?? new URL("https://dev.andreximenes.xyz");
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const rssUrl = new URL("rss.xml", site);
const ogImageUrl = new URL("/pwa-512x512.png", site).href;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#c45a1a" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/pwa-192x192.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_NAME}
			href={rssUrl}
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

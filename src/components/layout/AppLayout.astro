---
import { ChevronLeft } from "lucide-react";
import { SITE_NAME } from "@/content/site";
---

<div
	class="flex h-dvh flex-col overflow-hidden bg-paper print:h-auto print:overflow-visible"
>
	<header class="shrink-0 border-b border-rule print:hidden">
		<div
			class="container-page flex items-center justify-between gap-md py-sm"
		>
			<a
				href="/"
				class="focus-ring inline-flex min-h-11 min-w-0 items-center font-display text-sm font-semibold tracking-display text-ink no-underline hover:text-accent sm:text-base"
			>
				{SITE_NAME}
			</a>
			<a
				href={"/app"}
				class="focus-ring group ml-auto flex min-h-11 w-fit items-center gap-2 text-sm text-muted no-underline transition-colors duration-150 ease-out hover:text-ink"
			>
				<ChevronLeft
					size={16}
					className="shrink-0 transition-transform group-hover:-translate-x-0.5"
				/>
				Voltar para ferramentas
			</a>
		</div>
	</header>
	<main
		class="flex min-h-0 w-full flex-1 flex-col overflow-hidden print:overflow-visible"
	>
		<div class="flex min-h-0 flex-1 flex-col print:min-h-0 print:flex-none">
			<slot />
		</div>
	</main>
</div>

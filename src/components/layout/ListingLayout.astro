---
import type { Post } from "@/content.config";
import {
	getListingTitle,
	getSectionDescription,
	type SectionCategory,
} from "@/lib/sections";
import CoverGrid from "../ui/CoverGrid.astro";
import MainLayout from "./MainLayout.astro";

interface Props {
	recentPosts: Post[];
	activeCategory: string;
}

const { recentPosts, activeCategory } = Astro.props;

const listingTitle = getListingTitle(activeCategory);
const sectionEmpty = recentPosts.length === 0;
---

<MainLayout activeCategory={activeCategory}>
	<div class="container-page flex flex-col gap-xl py-lg pb-3xl">
		<section data-index-section aria-labelledby="listing">
			<header class="flex max-w-measure flex-col gap-2xs">
				<h1
					id="listing"
					class="m-0 font-display text-xl font-semibold leading-snug tracking-display text-ink"
				>
					{listingTitle}
				</h1>
				<p class="m-0 text-md leading-normal text-muted">
					{getSectionDescription(activeCategory as SectionCategory)}
				</p>
			</header>

			{
				recentPosts.length ? (
					<div class="mt-md">
						<CoverGrid posts={recentPosts} />
					</div>
				) : null
			}
		</section>

		<div
			id="search-empty"
			class:list={["py-md text-muted", !sectionEmpty && "hidden"]}
		>
			<p class="m-0">
				{
					sectionEmpty ? (
						"Nenhum item publicado nesta seção ainda."
					) : (
						<>
							Nenhum resultado para <span id="search-empty-term" />.
						</>
					)
				}
			</p>
			{
				sectionEmpty ? null : (
					<button
						type="button"
						id="search-clear"
						class="mt-sm inline-flex min-h-11 items-center border-0 bg-transparent p-0 text-sm text-accent hover:underline"
					>
						Limpar busca
					</button>
				)
			}
		</div>
	</div>
</MainLayout>

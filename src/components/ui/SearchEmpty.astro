---
const emptyClass = "py-md text-muted";
---

<div id="search-empty" class:list={[emptyClass, "hidden"]}>
	<p>
		Nenhum resultado para <span id="search-empty-term"></span>.
	</p>
	<button
		type="button"
		id="search-clear"
		class="mt-sm inline-flex min-h-11 items-center border-0 bg-transparent p-0 text-sm text-accent hover:underline"
	>
		Limpar busca
	</button>
</div>

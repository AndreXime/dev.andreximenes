---
import { Image } from "astro:assets";
import railLinks from "@/assets/home/rail-links.webp";
import railNotes from "@/assets/home/rail-notes.webp";
import railTools from "@/assets/home/rail-tools.webp";

const rails = [
	{
		href: "/app",
		label: "Apps",
		cta: "Ver apps",
		description: "Ferramentas que uso para criar, organizar e dar vida às ideias.",
		image: railTools,
	},
	{
		href: "/post",
		label: "Notas",
		cta: "Ler notas",
		description: "Reflexões, anotações e textos em construção.",
		image: railNotes,
	},
	{
		href: "/link",
		label: "Links",
		cta: "Explorar links",
		description: "Curadoria de lugares, recursos e referências que recomendo.",
		image: railLinks,
	},
] as const;
---

<section
	id="secoes"
	class="scroll-mt-lg border-b border-rule bg-paper-2 py-xl lg:py-2xl"
	aria-label="Seções do hub"
>
	<div class="container-page">
		<ul
			class="m-0 grid list-none grid-cols-1 gap-md p-0 lg:grid-cols-3 lg:gap-lg"
		>
			{
				rails.map((rail) => (
					<li>
						<a
							href={rail.href}
							class="focus-ring group flex h-full flex-col gap-md rounded-card bg-accent p-md no-underline transition-opacity duration-150 ease-out hover:opacity-95"
						>
							<span class="font-display text-lg font-semibold tracking-display text-accent-ink">
								{rail.label}
							</span>

							<span class="overflow-hidden rounded-sm">
								<Image
									src={rail.image}
									alt=""
									class="aspect-square w-full object-cover"
									widths={[400, 800]}
									sizes="(min-width: 1024px) 30vw, 100vw"
									loading="lazy"
									decoding="async"
								/>
							</span>

							<p class="m-0 text-md leading-normal text-accent-ink/80">
								{rail.description}
							</p>

							<span class="mt-auto inline-flex w-fit border-b border-accent-ink/40 pb-3xs text-sm font-medium text-accent-ink transition-colors duration-150 ease-out group-hover:border-accent-ink">
								{rail.cta} →
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
